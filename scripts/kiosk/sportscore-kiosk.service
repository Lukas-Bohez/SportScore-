[Unit]
Description=SportScore Kiosk Browser (user service)
Wants=network-online.target
After=network-online.target graphical.target

[Service]
Type=simple
# Edit ExecStart to point to the installed wrapper if you move it.
# Prefer to use KIOSK_URL environment var so we can override in different installs
Environment=KIOSK_URL=http://192.168.123.241
ExecStart=%h/.local/bin/start-kiosk.sh
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Example: set EXTRA_CHROMIUM_FLAGS='--disable-gpu --use-gl=egl' when needed
Environment=EXTRA_CHROMIUM_FLAGS=
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
